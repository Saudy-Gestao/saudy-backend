PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/saudy_db
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_48
CORS_ORIGIN=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_SECURE=true
SMTP_FROM=Saudy your-email@gmail.com

WHATSAPP_HSM_SYNC_INTERVAL_MINUTES=5
WHATSAPP_AUTOMATION_INTERVAL_MINUTES=5
WHATSAPP_HUMAN_TIMEOUT_INTERVAL_MINUTES=1

GOOGLE_STORAGE_BUCKET_DICOM=saudy-dicom
GOOGLE_STORAGE_BUCKET_ANEXOS=saudy-anexos
GOOGLE_APPLICATION_CREDENTIALS=saudy-dicom.json

ORTHANC_URL=http://localhost:8042
ORTHANC_AUTH=user:password
ORTHANC_RETENTION_DAYS=15

GROQ_API_KEY=your-groq-api-key

MWL_BRANCH_ID=your-branch-uuid
# Generate with: openssl rand -hex 24
MWL_PUBLIC_TOKEN=CHANGE_ME_use_openssl_rand_hex_24

WHATSAPP_CHATBOT_BRANCH_ID=your-branch-uuid
WHATSAPP_CHATBOT_SEARCH_DAYS=30
