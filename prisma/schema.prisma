generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum MaritalStatus {
    SINGLE
    MARRIED
    DIVORCED
    WIDOWED
    OTHER
}

enum BloodType {
    A_POSITIVE
    A_NEGATIVE
    B_POSITIVE
    B_NEGATIVE
    AB_POSITIVE
    AB_NEGATIVE
    O_POSITIVE
    O_NEGATIVE
}

enum TeaPreReservationStatus {
    PENDING_SCHEDULING
    PROPOSED
    RESERVED
    PENDING_AUTHORIZATION
    AUTHORIZED
    CONVERTED
    EXPIRED
    CANCELED
}

enum PreSchedulingStatus {
    PENDING
    PRE_AUTHORIZED
    LINK_SENT
    WAITING_PATIENT_DOCUMENTS
    DOCUMENTS_RECEIVED
    COMPLETED
    CANCELED
}

model Company {
    id                       String   @id @default(uuid())
    cnpj                     String   @unique
    legalName                String
    tradeName                String
    address                  String
    phone                    String
    module_type              String   @default("padrao") // 'padrao', 'tea', 'apenas-tea'
    additionalBranchesAllowed Int      @default(0)
    branches                 Branch[]

    @@map("companies")
}

model Branch {
    id         String          @id @default(uuid())
    companyId  String
    company    Company         @relation(fields: [companyId], references: [id])
    tradeName  String
    address    String
    phone      String
    isMatriz   Boolean         @default(false)
    sectors    Sector[]
    settings   BranchSettings?

    @@map("branches")
}

model BranchSettings {
    id                                   String   @id @default(uuid())
    branchId                             String   @unique
    branch                               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
    doctorCanScheduleExamFromConsultation Boolean @default(false)
    requireFacialForReportDelivery       Boolean  @default(false)
    requireFacialForPatientRegistration  Boolean  @default(true)
    noShowToleranceMinutes               Int      @default(30)
    publicCheckInEnabled                 Boolean  @default(false)
    publicCheckInLastEnabledAt           DateTime?
    publicCheckInLastEnabledByUserId     String?
    publicCheckInLastEnabledByName       String?
    publicCheckInLastDisabledAt          DateTime?
    publicCheckInLastDisabledByUserId    String?
    publicCheckInLastDisabledByName      String?

    @@map("branch_settings")
}

model BranchPublicCheckInAuditLog {
    id                String   @id @default(uuid())
    branchId          String
    action            String
    performedByUserId String?
    performedByName   String?
    createdAt         DateTime @default(now())

    @@index([branchId, createdAt])
    @@map("branch_public_check_in_audit_logs")
}

model PatientPortalAccessLog {
    id        String   @id @default(uuid())
    branchId  String?
    patientId String?
    cpf       String?
    event     String
    status    String
    message   String   @db.Text
    ipAddress String
    userAgent String?  @db.Text
    createdAt DateTime @default(now())

    @@index([patientId, createdAt])
    @@index([cpf, createdAt])
    @@index([event, createdAt])
    @@index([status, createdAt])
    @@index([branchId, createdAt])
    @@map("patient_portal_access_logs")
}

model PatientPortalDependentAuthorization {
    id                   String   @id @default(uuid())
    branchId             String?
    guardianPatientId    String?
    guardianCpf          String   @db.VarChar(11)
    dependentPatientId   String
    dependentCpf         String   @db.VarChar(11)
    relationship         String?
    authorizedByUserId   String?
    authorizedByName     String?
    status               String   @default("ACTIVE")
    startsAt             DateTime @default(now())
    expiresAt            DateTime?
    revokedAt            DateTime?
    revokedByUserId      String?
    revokedByName        String?
    notes                String?  @db.Text
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    @@index([guardianPatientId, status, startsAt, expiresAt])
    @@index([guardianCpf, status, startsAt, expiresAt])
    @@index([dependentPatientId, status])
    @@index([dependentCpf, status])
    @@index([branchId, status])
    @@map("patient_portal_dependent_authorizations")
}

model Sector {
    id          String @id @default(uuid())
    branchId    String
    branch      Branch @relation(fields: [branchId], references: [id])
    name        String
    description String
    workingDays String[] @default([])
    workingHoursStart String?
    workingHoursEnd String?
    users       User[]
    doctors     Doctor[]
    doctorRooms DoctorRoom[]
    medicalEquipments MedicalEquipment[]

    @@map("sectors")
}

model Access {
    id          String   @id @default(uuid())
    description String
    modules     Module[]
    users       User[]

    @@map("accesses")
}

model Module {
    id          String   @id @default(uuid())
    name        String   @unique
    label       String
    description String
    icon        String?
    category    String
    accesses    Access[]

    @@map("modules")
}

model User {
    id                 String              @id @default(uuid())
    sectorId           String
    sector             Sector              @relation(fields: [sectorId], references: [id])
    doctorId           String?
    doctor             Doctor?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
    accesses           Access[]
    name               String
    birthDate          DateTime
    email              String              @unique
    cpf                String?             @unique
    password           String              @default("")
    phone              String
    address            String
    passwordResetCodes PasswordResetCode[]

    @@index([doctorId])
    @@map("users")
}

model AdminUser {
    id                String    @id @default(uuid())
    name              String
    email             String    @unique
    password          String
    emailCodeHash     String?
    emailCodeExpiresAt DateTime?
    emailVerifiedAt   DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    @@map("admin_users")
}

model PasswordResetCode {
    id                String    @id @default(uuid())
    userId            String
    user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    codeHash          String
    requestIdentifier String
    attempts          Int       @default(0)
    expiresAt         DateTime
    usedAt            DateTime?
    createdAt         DateTime  @default(now())

    @@index([userId, createdAt])
    @@map("password_reset_codes")
}

model Doctor {
    id                String   @id @default(uuid())
    branchId          String?
    crm               String
    crmState          String   @db.VarChar(2)
    name              String
    email             String   @unique
    phone             String
    cellphone         String?
    birthDate         DateTime
    gender            Gender
    cpf               String   @unique @db.VarChar(11)
    rg                String?
    specialty         String
    specialties       String[] @default([])
    consultationFee   Decimal? @db.Decimal(10, 2)
    biography         String?  @db.Text
    address           String?
    addressNumber     String?
    addressComplement String?
    neighborhood      String?
    city              String?
    state             String?  @db.VarChar(2)
    zipCode           String?  @db.VarChar(8)
    roomId            String?
    room              Sector?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
    roomLinks         DoctorRoom[]
    isActive          Boolean  @default(true)
    workingDays       String[] @default([])
    workingHoursStart String?
    workingHoursEnd   String?
    workingSchedules  String   @default("[]") @db.Text
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    medicalRecords MedicalRecord[]
    users          User[]

    @@unique([crm, crmState])
    @@index([branchId])
    @@map("doctors")
}

model DoctorRoom {
    id        String   @id @default(uuid())
    doctorId  String
    roomId    String
    doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    room      Sector   @relation(fields: [roomId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@unique([doctorId, roomId])
    @@index([doctorId])
    @@index([roomId])
    @@map("doctor_rooms")
}

model Patient {
    id                           String         @id @default(uuid())
    branchId                     String?
    name                         String
    email                        String?
    phone                        String?
    cellphone                    String
    birthDate                    DateTime
    gender                       Gender?
    cpf                          String         @unique @db.VarChar(11)
    rg                           String?
    maritalStatus                MaritalStatus?
    occupation                   String?
    address                      String?
    addressNumber                String?
    addressComplement            String?
    neighborhood                 String?
    city                         String?
    state                        String?        @db.VarChar(2)
    zipCode                      String?        @db.VarChar(8)
    emergencyContactName         String?
    emergencyContactPhone        String?
    emergencyContactRelationship String?
    hasGuardian                  Boolean        @default(false)
    guardianName                 String?
    guardianCpf                  String?        @db.VarChar(11)
    guardianPhone                String?
    guardianRelationship         String?
    hasHealthInsurance           Boolean        @default(false)
    healthInsuranceName          String?
    healthInsuranceNumber        String?
    healthInsuranceExpiry        DateTime?
    bloodType                    BloodType?
    allergies                    String[]       @default([])
    chronicConditions            String[]       @default([])
    currentMedications           String[]       @default([])
    observations                 String?        @db.Text
    image                        Bytes?
    isActive                     Boolean        @default(true)
    createdAt                    DateTime       @default(now())
    updatedAt                    DateTime       @updatedAt

    medicalRecords     MedicalRecord[]
    teaProfile         TeaProfile?
    teaPreReservations TeaPreReservation[]
    facialLogs         FacialLog[]

    @@index([branchId])
    @@map("patients")
}

model TeaProfile {
    id                   String   @id @default(uuid())
    patientId            String   @unique
    patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    supportLevel         String?
    communicationProfile String?  @db.Text
    sensoryProfile       String?  @db.Text
    behaviorNotes        String?  @db.Text
    comorbidities        String[] @default([])
    therapeuticGoals     String?  @db.Text
    familyGuidance       String?  @db.Text
    schoolNotes          String?  @db.Text
    isActive             Boolean  @default(true)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    plans           TeaTherapeuticPlan[]
    evolutions      TeaEvolution[]
    pit             TeaPit?
    preReservations TeaPreReservation[]

    @@map("tea_profiles")
}

model TeaTherapeuticPlan {
    id                      String     @id @default(uuid())
    teaProfileId            String
    teaProfile              TeaProfile @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    title                   String
    objective               String?    @db.Text
    priority                String     @default("Média")
    status                  String     @default("Ativo")
    responsibleDoctorId     String?
    responsibleProfessional String?
    targetDate              DateTime?
    notes                   String?    @db.Text
    isActive                Boolean    @default(true)
    createdAt               DateTime   @default(now())
    updatedAt               DateTime   @updatedAt

    evolutions TeaEvolution[]

    @@index([teaProfileId])
    @@map("tea_therapeutic_plans")
}

model TeaEvolution {
    id                   String              @id @default(uuid())
    teaProfileId         String
    teaProfile           TeaProfile          @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    therapeuticPlanId    String?
    therapeuticPlan      TeaTherapeuticPlan? @relation(fields: [therapeuticPlanId], references: [id], onDelete: SetNull)
    appointmentId        String?
    appointment          Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
    sessionDate          DateTime            @default(now())
    professionalDoctorId String?
    professional         String?
    interventionSummary  String?             @db.Text
    patientResponse      String?             @db.Text
    progressScore        Int?
    sessionGoal          String?             @db.Text
    strategiesUsed       String[]            @default([])
    engagementLevel      String?
    regulationLevel      String?
    behaviorLevel        String?
    familyFeedback       String?             @db.Text
    homePlan             String?             @db.Text
    alerts               String?             @db.Text
    createdBy            String?
    lastEditedBy         String?
    lastEditReason       String?             @db.Text
    notes                String?             @db.Text
    createdAt            DateTime            @default(now())
    updatedAt            DateTime            @updatedAt

    @@index([teaProfileId])
    @@index([therapeuticPlanId])
    @@index([appointmentId])
    @@map("tea_evolutions")
}

model TeaPit {
    id           String     @id @default(uuid())
    teaProfileId String     @unique
    teaProfile   TeaProfile @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    title        String
    startDate    DateTime?
    reviewDate   DateTime?
    status       String     @default("Ativo")
    notes        String?    @db.Text
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    therapies       TeaPitTherapy[]
    preReservations TeaPreReservation[]

    @@map("tea_pits")
}

model TeaPitTherapy {
    id                   String   @id @default(uuid())
    pitId                String
    pit                  TeaPit   @relation(fields: [pitId], references: [id], onDelete: Cascade)
    procedureId          String?
    therapyType          String
    weeklyFrequency      Int      @default(1)
    preferredWeekdays    String[] @default([])
    preferredShift       String?
    durationMinutes      Int?
    professionalDoctorId String?
    professional         String?
    notes                String?  @db.Text
    isActive             Boolean  @default(true)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    preReservations TeaPreReservation[]

    @@index([pitId])
    @@map("tea_pit_therapies")
}

model MedicalRecord {
    id                      String   @id @default(uuid())
    patientId               String
    patient                 Patient  @relation(fields: [patientId], references: [id])
    consultationId          String?  @unique
    consultation            Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
    doctorId                String?
    doctor                  Doctor?  @relation(fields: [doctorId], references: [id])
    riskClassification      String?
    chiefComplaint          String?  @db.Text
    historyOfPresentIllness String?  @db.Text
    physicalExamination     String?  @db.Text
    diagnosis               String?  @db.Text
    treatment               String?  @db.Text
    prescriptions           String?  @db.Text
    examRequests            String?  @db.Text
    notes                   String?  @db.Text
    bloodPressureSystolic   Int?
    bloodPressureDiastolic  Int?
    heartRate               Int?
    respiratoryRate         Int?
    temperature             Decimal? @db.Decimal(4, 1)
    oxygenSaturation        Int?
    weight                  Decimal? @db.Decimal(5, 2)
    height                  Decimal? @db.Decimal(3, 2)
    bmi                     Decimal? @db.Decimal(4, 1)
    recordDate              DateTime @default(now())
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    @@map("medical_records")
}

model AdminEntity {
    id   String @id @default(uuid())
    name String

    @@map("admin_entities")
}

model InventoryItem {
    id          String    @id @default(uuid())
    code        String    @unique
    name        String
    category    String?
    unit        String?
    quantity    Int       @default(0)
    minQuantity Int?
    maxQuantity Int?
    unitPrice   Decimal?  @db.Decimal(12, 2)
    expiryDate  DateTime?
    status      String    @default("AVAILABLE")
    notes       String?   @db.Text
    isActive    Boolean   @default(true)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    procedureMaterials ProcedureMaterial[]
    lots        InventoryLot[]
    procedureMaterialKitItems ProcedureMaterialKitItem[]
    inventoryKitItems InventoryKitItem[]

    @@map("inventory_items")
}

model InventoryMovement {
    id              String   @id @default(uuid())
    inventoryItemId String
    type            String
    quantity        Int
    reason          String
    notes           String?
    previousQty     Int
    resultingQty    Int
    createdByUserId String?
    createdByName   String?
    createdAt       DateTime @default(now())

    @@index([inventoryItemId, createdAt])
    @@map("inventory_movements")
}

model InventoryLot {
    id              String   @id @default(uuid())
    inventoryItemId String
    lotCode         String
    quantity        Int
    expiryDate      DateTime?
    unitPrice       Decimal? @db.Decimal(12, 2)
    supplier        String?
    notes           String?
    createdByUserId String?
    createdByName   String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

    @@unique([inventoryItemId, lotCode])
    @@index([inventoryItemId, expiryDate])
    @@map("inventory_lots")
}

model InventoryKit {
    id          String   @id @default(uuid())
    name        String
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    items       InventoryKitItem[]
    procedureBindings ProcedureKitBinding[]

    @@index([isActive, name])
    @@map("inventory_kits")
}

model InventoryKitItem {
    id              String   @id @default(uuid())
    kitId           String
    inventoryItemId String
    quantity        Int      @default(1)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    kit           InventoryKit   @relation(fields: [kitId], references: [id], onDelete: Cascade)
    inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

    @@unique([kitId, inventoryItemId])
    @@index([kitId])
    @@index([inventoryItemId])
    @@map("inventory_kit_items")
}

model FinanceEntry {
    id            String    @id @default(uuid())
    type          String
    category      String?
    description   String?   @db.Text
    value         Decimal   @db.Decimal(12, 2)
    discount      Decimal?  @db.Decimal(12, 2)
    total         Decimal   @db.Decimal(12, 2)
    dueDate       DateTime?
    status        String    @default("PENDING")
    paymentMethod String?
    relatedName   String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    isActive      Boolean   @default(true)

    @@map("finance_entries")
}

model Invoice {
    id            String    @id @default(uuid())
    number        String    @unique
    sourceAppointmentId String? @unique
    sourceConsultationId String? @unique
    patientName   String?
    beneficiaryCardNumber String?
    beneficiaryPlan String?
    beneficiaryCardExpiry String?
    beneficiaryStatus String?
    holderName String?
    holderDocument String?
    dependentName String?
    dependentRelationship String?
    guideType String?
    operatorGuideNumber String?
    authorizationPassword String?
    authorizationDate DateTime?
    authorizationExpiryDate DateTime?
    authorizedAttendanceType String?
    packageValue Decimal? @db.Decimal(12, 2)
    materialsValue Decimal? @db.Decimal(12, 2)
    feesValue Decimal? @db.Decimal(12, 2)
    dailyValue Decimal? @db.Decimal(12, 2)
    gasesValue Decimal? @db.Decimal(12, 2)
    opmeValue Decimal? @db.Decimal(12, 2)
    expectedDiscountValue Decimal? @db.Decimal(12, 2)
    expectedGlosaValue Decimal? @db.Decimal(12, 2)
    cidCode String?
    clinicalIndication String?
    requestingProfessionalName String?
    requestingProfessionalCpf String?
    requestingProfessionalCouncil String?
    requestingProfessionalCouncilUf String?
    requestingProfessionalCouncilNumber String?
    requestingProfessionalCbo String?
    executingProfessionalName String?
    executingProfessionalCpf String?
    executingProfessionalCouncil String?
    executingProfessionalCouncilUf String?
    executingProfessionalCouncilNumber String?
    executingProfessionalCbo String?
    procedureItems InvoiceProcedureItem[]
    issuedAt      DateTime  @default(now())
    dueDate       DateTime?
    status        String    @default("EMITIDA")
    convention    String?
    value         Decimal   @db.Decimal(12, 2)
    discount      Decimal?  @db.Decimal(12, 2)
    total         Decimal   @db.Decimal(12, 2)
    paymentMethod String?
    tissBatchItems TissBatchItem[]
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    isActive      Boolean   @default(true)

    @@map("invoices")
}

model InvoiceProcedureItem {
    id             String   @id @default(uuid())
    invoiceId      String
    invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
    procedureId    String?
    procedureName  String
    tussCode       String?
    tableCode      String?
    quantity       Int      @default(1)
    executedAt     DateTime?
    unitValue      Decimal  @db.Decimal(12, 2)
    totalValue     Decimal  @db.Decimal(12, 2)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@index([invoiceId])
    @@index([procedureId])
    @@map("invoice_procedure_items")
}

model TissBatch {
    id              String          @id @default(uuid())
    batchNumber     String          @unique
    competenceMonth String
    convention      String
    status          String          @default("DRAFT")
    protocolNumber  String?
    generatedXmlAt  DateTime?
    sentAt          DateTime?
    createdByUserId String?
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt
    isActive        Boolean         @default(true)
    items           TissBatchItem[]

    @@index([status, competenceMonth])
    @@index([convention, competenceMonth])
    @@map("tiss_batches")
}

model TissBatchItem {
    id         String    @id @default(uuid())
    batchId    String
    invoiceId  String
    guideNumber String
    status     String    @default("PENDING")
    returnStatus String?
    returnCode String?
    returnMessage String?
    glosaValue Decimal? @db.Decimal(12, 2)
    isRepresented Boolean @default(false)
    representedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    isActive   Boolean   @default(true)
    batch      TissBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
    invoice    Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

    @@unique([invoiceId, isActive])
    @@index([batchId, status])
    @@map("tiss_batch_items")
}

model Delivery {
    id           String    @id @default(uuid())
    patientName  String
    documentType String
    availableAt  DateTime  @default(now())
    description  String?   @db.Text
    responsible  String?
    status       String    @default("DISPONIVEL")
    deliveredTo  String?
    deliveredAt  DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    isActive     Boolean   @default(true)

    @@map("deliveries")
}

model PreAttendance {
    id                 String   @id @default(uuid())
    branchId           String?
    fullName           String
    cpf                String
    patientId          String?
    appointmentId      String?
    birthDate          String?
    gender             String?
    phone              String?
    email              String?
    address            String?
    convenio           String?
    convenioType       String?
    convenioValidUntil String?
    convenioNumber     String?
    convenioStatus     String?
    convenioNotes      String?
    bloodPressure      String?
    heartRate          String?
    temperature        String?
    oxygenSaturation   String?
    weight             String?
    height             String?
    glucose            String?
    bmi                String?
    mainComplaint      String?
    diseaseHistory     String?
    allergies          String?
    medications        String?
    antecedentes       String?
    triageNotes        String?
    notes              String?
    totem              Int?
    status             String?
    queue              String?
    queueType          String?
    agenda             String?
    doctorId           String?
    doctorName         String?
    checklistStartedAt DateTime?
    checklistCompletedAt DateTime?
    finalFacialValidationAt DateTime?
    finalFacialValidationStatus String?
    finalFacialValidationTrust Float?
    finalFacialValidationName String?
    finalFacialValidationCpf String?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
    isActive           Boolean  @default(true)

    @@index([doctorId])
    @@index([branchId])
    @@index([appointmentId])
    @@map("pre_attendances")
}

model TeaPreReservation {
    id                   String                      @id @default(uuid())
    teaProfileId         String
    teaProfile           TeaProfile                  @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    pitId                String
    pit                  TeaPit                      @relation(fields: [pitId], references: [id], onDelete: Cascade)
    pitTherapyId         String
    pitTherapy           TeaPitTherapy               @relation(fields: [pitTherapyId], references: [id], onDelete: Cascade)
    patientId            String
    patient              Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
    procedureId          String?
    procedureName        String?
    professionalDoctorId String?
    professionalName     String?
    suggestedDate        DateTime?
    suggestedTime        String?
    durationMinutes      Int?
    status               TeaPreReservationStatus     @default(PENDING_SCHEDULING)
    notes                String?                     @db.Text
    expiresAt            DateTime?
    authorizedAt         DateTime?
    convertedAt          DateTime?
    createdAt            DateTime                    @default(now())
    updatedAt            DateTime                    @updatedAt
    timelineEvents       TeaPreReservationTimeline[]

    @@index([status])
    @@index([pitTherapyId, status])
    @@index([patientId])
    @@map("tea_pre_reservations")
}

model TeaPreReservationTimeline {
    id               String            @id @default(uuid())
    preReservationId String
