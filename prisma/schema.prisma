generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum MaritalStatus {
    SINGLE
    MARRIED
    DIVORCED
    WIDOWED
    OTHER
}

enum BloodType {
    A_POSITIVE
    A_NEGATIVE
    B_POSITIVE
    B_NEGATIVE
    AB_POSITIVE
    AB_NEGATIVE
    O_POSITIVE
    O_NEGATIVE
}

enum TeaPreReservationStatus {
    PENDING_SCHEDULING
    PROPOSED
    RESERVED
    PENDING_AUTHORIZATION
    AUTHORIZED
    CONVERTED
    EXPIRED
    CANCELED
}

enum PreSchedulingStatus {
    PENDING
    PRE_AUTHORIZED
    LINK_SENT
    WAITING_PATIENT_DOCUMENTS
    DOCUMENTS_RECEIVED
    COMPLETED
    CANCELED
}

model Company {
    id        String   @id @default(uuid())
    cnpj      String   @unique
    legalName String
    tradeName String
    address   String
    phone     String
    branches  Branch[]

    @@map("companies")
}

model Branch {
    id         String          @id @default(uuid())
    companyId  String
    company    Company         @relation(fields: [companyId], references: [id])
    tradeName  String
    address    String
    phone      String
    isMatriz   Boolean         @default(false)
    sectors    Sector[]
    settings   BranchSettings?

    @@map("branches")
}

model BranchSettings {
    id                              String  @id @default(uuid())
    branchId                        String  @unique
    branch                          Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
    requireFacialForReportDelivery  Boolean @default(false)
    requireFacialForPatientRegistration Boolean @default(true)
    noShowToleranceMinutes          Int     @default(30)

    @@map("branch_settings")
}

model Sector {
    id          String @id @default(uuid())
    branchId    String
    branch      Branch @relation(fields: [branchId], references: [id])
    name        String
    description String
    users       User[]
    doctors     Doctor[]
    doctorRooms DoctorRoom[]
    medicalEquipments MedicalEquipment[]

    @@map("sectors")
}

model Access {
    id          String   @id @default(uuid())
    description String
    modules     Module[]
    users       User[]

    @@map("accesses")
}

model Module {
    id          String   @id @default(uuid())
    name        String   @unique
    label       String
    description String
    icon        String?
    category    String
    accesses    Access[]

    @@map("modules")
}

model User {
    id                 String              @id @default(uuid())
    sectorId           String
    sector             Sector              @relation(fields: [sectorId], references: [id])
    doctorId           String?
    doctor             Doctor?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
    accesses           Access[]
    name               String
    birthDate          DateTime
    email              String              @unique
    cpf                String?             @unique
    password           String              @default("")
    phone              String
    address            String
    passwordResetCodes PasswordResetCode[]

    @@index([doctorId])
    @@map("users")
}

model AdminUser {
    id                String    @id @default(uuid())
    name              String
    email             String    @unique
    password          String
    emailCodeHash     String?
    emailCodeExpiresAt DateTime?
    emailVerifiedAt   DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    @@map("admin_users")
}

model PasswordResetCode {
    id                String    @id @default(uuid())
    userId            String
    user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    codeHash          String
    requestIdentifier String
    attempts          Int       @default(0)
    expiresAt         DateTime
    usedAt            DateTime?
    createdAt         DateTime  @default(now())

    @@index([userId, createdAt])
    @@map("password_reset_codes")
}

model Doctor {
    id                String   @id @default(uuid())
    branchId          String?
    crm               String
    crmState          String   @db.VarChar(2)
    name              String
    email             String   @unique
    phone             String
    cellphone         String?
    birthDate         DateTime
    gender            Gender
    cpf               String   @unique @db.VarChar(11)
    rg                String?
    specialty         String
    specialties       String[] @default([])
    consultationFee   Decimal? @db.Decimal(10, 2)
    biography         String?  @db.Text
    address           String?
    addressNumber     String?
    addressComplement String?
    neighborhood      String?
    city              String?
    state             String?  @db.VarChar(2)
    zipCode           String?  @db.VarChar(8)
    roomId            String?
    room              Sector?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
    roomLinks         DoctorRoom[]
    isActive          Boolean  @default(true)
    workingDays       String[] @default([])
    workingHoursStart String?
    workingHoursEnd   String?
    workingSchedules  String   @default("[]") @db.Text
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    medicalRecords MedicalRecord[]
    users          User[]

    @@unique([crm, crmState])
    @@index([branchId])
    @@map("doctors")
}

model DoctorRoom {
    id        String   @id @default(uuid())
    doctorId  String
    roomId    String
    doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
    room      Sector   @relation(fields: [roomId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@unique([doctorId, roomId])
    @@index([doctorId])
    @@index([roomId])
    @@map("doctor_rooms")
}

model Patient {
    id                           String         @id @default(uuid())
    branchId                     String?
    name                         String
    email                        String?
    phone                        String?
    cellphone                    String
    birthDate                    DateTime
    gender                       Gender
    cpf                          String         @unique @db.VarChar(11)
    rg                           String?
    maritalStatus                MaritalStatus?
    occupation                   String?
    address                      String?
    addressNumber                String?
    addressComplement            String?
    neighborhood                 String?
    city                         String?
    state                        String?        @db.VarChar(2)
    zipCode                      String?        @db.VarChar(8)
    emergencyContactName         String?
    emergencyContactPhone        String?
    emergencyContactRelationship String?
    hasGuardian                  Boolean        @default(false)
    guardianName                 String?
    guardianCpf                  String?        @db.VarChar(11)
    guardianPhone                String?
    guardianRelationship         String?
    hasHealthInsurance           Boolean        @default(false)
    healthInsuranceName          String?
    healthInsuranceNumber        String?
    healthInsuranceExpiry        DateTime?
    bloodType                    BloodType?
    allergies                    String[]       @default([])
    chronicConditions            String[]       @default([])
    currentMedications           String[]       @default([])
    observations                 String?        @db.Text
    image                        Bytes?
    isActive                     Boolean        @default(true)
    createdAt                    DateTime       @default(now())
    updatedAt                    DateTime       @updatedAt

    medicalRecords     MedicalRecord[]
    teaProfile         TeaProfile?
    teaPreReservations TeaPreReservation[]
    facialLogs         FacialLog[]

    @@index([branchId])
    @@map("patients")
}

model TeaProfile {
    id                   String   @id @default(uuid())
    patientId            String   @unique
    patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    supportLevel         String?
    communicationProfile String?  @db.Text
    sensoryProfile       String?  @db.Text
    behaviorNotes        String?  @db.Text
    comorbidities        String[] @default([])
    therapeuticGoals     String?  @db.Text
    familyGuidance       String?  @db.Text
    schoolNotes          String?  @db.Text
    isActive             Boolean  @default(true)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    plans           TeaTherapeuticPlan[]
    evolutions      TeaEvolution[]
    pit             TeaPit?
    preReservations TeaPreReservation[]

    @@map("tea_profiles")
}

model TeaTherapeuticPlan {
    id                      String     @id @default(uuid())
    teaProfileId            String
    teaProfile              TeaProfile @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    title                   String
    objective               String?    @db.Text
    priority                String     @default("Média")
    status                  String     @default("Ativo")
    responsibleDoctorId     String?
    responsibleProfessional String?
    targetDate              DateTime?
    notes                   String?    @db.Text
    isActive                Boolean    @default(true)
    createdAt               DateTime   @default(now())
    updatedAt               DateTime   @updatedAt

    evolutions TeaEvolution[]

    @@index([teaProfileId])
    @@map("tea_therapeutic_plans")
}

model TeaEvolution {
    id                   String              @id @default(uuid())
    teaProfileId         String
    teaProfile           TeaProfile          @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    therapeuticPlanId    String?
    therapeuticPlan      TeaTherapeuticPlan? @relation(fields: [therapeuticPlanId], references: [id], onDelete: SetNull)
    appointmentId        String?
    appointment          Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
    sessionDate          DateTime            @default(now())
    professionalDoctorId String?
    professional         String?
    interventionSummary  String?             @db.Text
    patientResponse      String?             @db.Text
    progressScore        Int?
    sessionGoal          String?             @db.Text
    strategiesUsed       String[]            @default([])
    engagementLevel      String?
    regulationLevel      String?
    behaviorLevel        String?
    familyFeedback       String?             @db.Text
    homePlan             String?             @db.Text
    alerts               String?             @db.Text
    createdBy            String?
    lastEditedBy         String?
    lastEditReason       String?             @db.Text
    notes                String?             @db.Text
    createdAt            DateTime            @default(now())
    updatedAt            DateTime            @updatedAt

    @@index([teaProfileId])
    @@index([therapeuticPlanId])
    @@index([appointmentId])
    @@map("tea_evolutions")
}

model TeaPit {
    id           String     @id @default(uuid())
    teaProfileId String     @unique
    teaProfile   TeaProfile @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    title        String
    startDate    DateTime?
    reviewDate   DateTime?
    status       String     @default("Ativo")
    notes        String?    @db.Text
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    therapies       TeaPitTherapy[]
    preReservations TeaPreReservation[]

    @@map("tea_pits")
}

model TeaPitTherapy {
    id                   String   @id @default(uuid())
    pitId                String
    pit                  TeaPit   @relation(fields: [pitId], references: [id], onDelete: Cascade)
    procedureId          String?
    therapyType          String
    weeklyFrequency      Int      @default(1)
    preferredWeekdays    String[] @default([])
    preferredShift       String?
    durationMinutes      Int?
    professionalDoctorId String?
    professional         String?
    notes                String?  @db.Text
    isActive             Boolean  @default(true)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    preReservations TeaPreReservation[]

    @@index([pitId])
    @@map("tea_pit_therapies")
}

model MedicalRecord {
    id                      String   @id @default(uuid())
    patientId               String
    patient                 Patient  @relation(fields: [patientId], references: [id])
    doctorId                String?
    doctor                  Doctor?  @relation(fields: [doctorId], references: [id])
    chiefComplaint          String?  @db.Text
    historyOfPresentIllness String?  @db.Text
    physicalExamination     String?  @db.Text
    diagnosis               String?  @db.Text
    treatment               String?  @db.Text
    prescriptions           String?  @db.Text
    examRequests            String?  @db.Text
    notes                   String?  @db.Text
    bloodPressureSystolic   Int?
    bloodPressureDiastolic  Int?
    heartRate               Int?
    respiratoryRate         Int?
    temperature             Decimal? @db.Decimal(4, 1)
    oxygenSaturation        Int?
    weight                  Decimal? @db.Decimal(5, 2)
    height                  Decimal? @db.Decimal(3, 2)
    bmi                     Decimal? @db.Decimal(4, 1)
    recordDate              DateTime @default(now())
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    @@map("medical_records")
}

model AdminEntity {
    id   String @id @default(uuid())
    name String

    @@map("admin_entities")
}

model InventoryItem {
    id          String    @id @default(uuid())
    code        String    @unique
    name        String
    category    String?
    unit        String?
    quantity    Int       @default(0)
    minQuantity Int?
    maxQuantity Int?
    unitPrice   Decimal?  @db.Decimal(12, 2)
    expiryDate  DateTime?
    status      String    @default("AVAILABLE")
    notes       String?   @db.Text
    isActive    Boolean   @default(true)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    procedureMaterials ProcedureMaterial[]

    @@map("inventory_items")
}

model FinanceEntry {
    id            String    @id @default(uuid())
    type          String
    category      String?
    description   String?   @db.Text
    value         Decimal   @db.Decimal(12, 2)
    discount      Decimal?  @db.Decimal(12, 2)
    total         Decimal   @db.Decimal(12, 2)
    dueDate       DateTime?
    status        String    @default("PENDING")
    paymentMethod String?
    relatedName   String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    isActive      Boolean   @default(true)

    @@map("finance_entries")
}

model Invoice {
    id            String    @id @default(uuid())
    number        String    @unique
    patientName   String?
    issuedAt      DateTime  @default(now())
    dueDate       DateTime?
    status        String    @default("EMITIDA")
    convention    String?
    value         Decimal   @db.Decimal(12, 2)
    discount      Decimal?  @db.Decimal(12, 2)
    total         Decimal   @db.Decimal(12, 2)
    paymentMethod String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    isActive      Boolean   @default(true)

    @@map("invoices")
}

model Delivery {
    id           String    @id @default(uuid())
    patientName  String
    documentType String
    availableAt  DateTime  @default(now())
    description  String?   @db.Text
    responsible  String?
    status       String    @default("DISPONIVEL")
    deliveredTo  String?
    deliveredAt  DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    isActive     Boolean   @default(true)

    @@map("deliveries")
}

model PreAttendance {
    id                 String   @id @default(uuid())
    branchId           String?
    fullName           String
    cpf                String
    patientId          String?
    appointmentId      String?
    birthDate          String?
    gender             String?
    phone              String?
    email              String?
    address            String?
    convenio           String?
    convenioType       String?
    convenioValidUntil String?
    convenioNumber     String?
    convenioStatus     String?
    convenioNotes      String?
    bloodPressure      String?
    heartRate          String?
    temperature        String?
    oxygenSaturation   String?
    weight             String?
    height             String?
    glucose            String?
    bmi                String?
    mainComplaint      String?
    diseaseHistory     String?
    allergies          String?
    medications        String?
    antecedentes       String?
    triageNotes        String?
    notes              String?
    totem              Int?
    status             String?
    queue              String?
    queueType          String?
    agenda             String?
    doctorId           String?
    doctorName         String?
    checklistStartedAt DateTime?
    checklistCompletedAt DateTime?
    finalFacialValidationAt DateTime?
    finalFacialValidationStatus String?
    finalFacialValidationTrust Float?
    finalFacialValidationName String?
    finalFacialValidationCpf String?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
    isActive           Boolean  @default(true)

    @@index([doctorId])
    @@index([branchId])
    @@index([appointmentId])
    @@map("pre_attendances")
}

model TeaPreReservation {
    id                   String                      @id @default(uuid())
    teaProfileId         String
    teaProfile           TeaProfile                  @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    pitId                String
    pit                  TeaPit                      @relation(fields: [pitId], references: [id], onDelete: Cascade)
    pitTherapyId         String
    pitTherapy           TeaPitTherapy               @relation(fields: [pitTherapyId], references: [id], onDelete: Cascade)
    patientId            String
    patient              Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
    procedureId          String?
    procedureName        String?
    professionalDoctorId String?
    professionalName     String?
    suggestedDate        DateTime?
    suggestedTime        String?
    durationMinutes      Int?
    status               TeaPreReservationStatus     @default(PENDING_SCHEDULING)
    notes                String?                     @db.Text
    expiresAt            DateTime?
    authorizedAt         DateTime?
    convertedAt          DateTime?
    createdAt            DateTime                    @default(now())
    updatedAt            DateTime                    @updatedAt
    timelineEvents       TeaPreReservationTimeline[]

    @@index([status])
    @@index([pitTherapyId, status])
    @@index([patientId])
    @@map("tea_pre_reservations")
}

model TeaPreReservationTimeline {
    id               String            @id @default(uuid())
    preReservationId String
    preReservation   TeaPreReservation @relation(fields: [preReservationId], references: [id], onDelete: Cascade)
    eventType        String
    eventLabel       String
    actor            String?
    payload          Json?
    createdAt        DateTime          @default(now())

    @@index([preReservationId, createdAt])
    @@map("tea_pre_reservation_timeline")
}

model Appointment {
    id              String   @id @default(uuid())
    branchId        String?
    rescheduledFromAppointmentId String?
    rescheduledFromAppointment Appointment? @relation("AppointmentReschedule", fields: [rescheduledFromAppointmentId], references: [id], onDelete: SetNull)
    rescheduledAppointments Appointment[] @relation("AppointmentReschedule")
    patientName     String?
    patientCpf      String?
    patientId       String?
    doctorName      String?
    specialty       String?
    convenio        String?
    date            String?
    time            String?
    durationMinutes Int?
    type            String?
    status          String?
    accessionNumber String?
    authorizationStatus String @default("PENDING")
    authorizationNotes  String? @db.Text
    authorizedAt        DateTime?
    inventoryConsumedAt DateTime?
    observations    String?
    totem           Int?
    preSchedulingFlow PreSchedulingFlow?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    isActive        Boolean  @default(true)
    teaEvolutions   TeaEvolution[]
    worklistItems   ReportWorklistItem[]
    laudos          Report[]
    mwlEntries      MwlEntry[]
    attachments     AppointmentAttachment[]

    @@index([branchId])
    @@index([rescheduledFromAppointmentId])
    @@index([authorizationStatus], map: "appointments_authorizationStatus_idx")
    @@map("appointments")
}

model AppointmentAttachment {
    id               String      @id @default(uuid())
    branchId         String
    appointmentId    String
    appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
    fileName         String
    mimeType         String?
    sizeBytes        Int?
    gcsObjectName    String
    uploadedByUserId String?
    uploadedAt       DateTime    @default(now())
    createdAt        DateTime    @default(now())
    isActive         Boolean     @default(true)

    @@index([branchId])
    @@index([appointmentId])
    @@map("appointment_attachments")
}

// Modality Worklist entry — created when appointment is confirmed, consumed when DICOM arrives
model MwlEntry {
    id               String       @id @default(uuid())
    branchId         String?
    appointmentId    String?
    appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
    accessionNumber  String?      // populated at creation, used to correlate incoming DICOM
    patientName      String?
    patientCpf       String?
    examType         String?      // modality or exam name
    scheduledAt      String?      // "YYYY-MM-DD HH:mm"
    convenio         String?
    requestingDoctor String?
    status           String       @default("agendado") // agendado | adquirido | cancelado
    worklistItems    ReportWorklistItem[]
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt
    isActive         Boolean      @default(true)

    @@index([branchId])
    @@index([appointmentId])
    @@index([accessionNumber])
    @@index([patientCpf])
    @@index([status])
    @@map("mwl_entries")
}

model PreSchedulingFlow {
    id                    String              @id @default(uuid())
    branchId              String?
    appointmentId         String              @unique
    appointment           Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
    patientId             String?
    patientName           String?
    patientCpf            String?
    patientPhone          String?
    status                PreSchedulingStatus @default(PENDING)
    preAuthorizedAt       DateTime?
    guideNumber           String?
    preAuthorizationNotes String?             @db.Text
    publicToken           String              @unique
    linkSentAt            DateTime?
    linkSentByUserId      String?
    linkMockMessage       String?             @db.Text
    patientVerifiedAt     DateTime?
    patientVerifiedCpf    String?
    patientVerifiedName   String?
    patientVerifiedTrust  Float?
    patientSubmittedAt    DateTime?
    completedAt           DateTime?
    createdAt             DateTime            @default(now())
    updatedAt             DateTime            @updatedAt
    documents             PreSchedulingDocument[]

    @@index([branchId])
    @@index([status])
    @@index([patientCpf])
    @@map("pre_scheduling_flows")
}

model PreSchedulingDocument {
    id                String           @id @default(uuid())
    flowId            String
    flow              PreSchedulingFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
    documentType      String
    fileName          String
    mimeType          String?
    sizeBytes         Int?
    gcsObjectName     String
    uploadedByType    String           @default("PATIENT")
    uploadedByCpf     String?
    uploadedAt        DateTime         @default(now())
    createdAt         DateTime         @default(now())

    @@index([flowId, uploadedAt])
    @@map("pre_scheduling_documents")
}

model ConvenioAuthorizationAttachment {
    id                String   @id @default(uuid())
    branchId          String
    sourceType        String
    appointmentId     String?
    pitTherapyId      String?
    fileName          String
    mimeType          String?
    sizeBytes         Int?
    gcsObjectName     String
    uploadedByUserId  String?
    uploadedAt        DateTime @default(now())
    createdAt         DateTime @default(now())
    isActive          Boolean  @default(true)

    @@index([branchId, sourceType])
    @@index([appointmentId])
    @@index([pitTherapyId])
    @@map("convenio_authorization_attachments")
}

model Consultation {
    id               String   @id @default(uuid())
    branchId         String?
    doctorId         String?
    appointmentId    String?
    doctorName       String?
    patientName      String?
    convenio         String?
    convenioStatus   String?
    scheduledFor     String?
    queueType        String?
    agenda           String?
    totem            String?
    queue            String?
    bloodPressure    String?
    heartRate        String?
    temperature      String?
    oxygenSaturation String?
    weight           String?
    height           String?
    glucose          String?
    bmi              String?
    anamnese         String?
    mainComplaint    String?
    diseaseHistory   String?
    allergies        String?
    medications      String?
    antecedentes     String?
    pregnant         String?
    triageNotes      String?
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    isActive         Boolean  @default(true)

    @@index([doctorId])
    @@index([branchId])
    @@index([appointmentId])
    @@map("consultations")
}

model Report {
    id                String              @id @default(uuid())
    branchId          String?
    worklistItemId    String?
    worklistItem      ReportWorklistItem? @relation(fields: [worklistItemId], references: [id], onDelete: SetNull)
    appointmentId     String?
    appointment       Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
    patientName       String?             // nullable: can be sourced from linked appointment
    cpf               String?
    birthDate         String?
    requestingDoctor  String?
    reportingDoctor   String?
    reviewingDoctor   String?
    description       String?
    conclusion        String?
    notes             String?
    status            String?             @default("rascunho")
    exam              String?
    scheduledFor      String?
    responsibleDoctor String?
    observation       String?
    issuerSignedAt    String?
    reviewerSignedAt  String?
    addendums         ReportAddendum[]
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt
    isActive          Boolean             @default(true)

    @@index([branchId])
    @@index([worklistItemId])
    @@index([appointmentId])
    @@map("reports")
}

model ReportWorklistItem {
    id               String    @id @default(uuid())
    branchId         String?
    mwlEntryId       String?   // FK to MwlEntry — set when DICOM is correlated to a worklist entry
    mwlEntry         MwlEntry? @relation(fields: [mwlEntryId], references: [id], onDelete: SetNull)
    appointmentId    String?   // convenience: denormalized from mwlEntry.appointmentId
    appointment      Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
    externalStudyId  String?
    accessionNumber  String?
    patientCpf       String?
    // patient metadata is sourced from linked appointment when available
    // duplicates are avoided by not keeping these fields on worklist
    dicomStudyUid    String?
    dicomSeriesUid   String?
    dicomPath        String?   // local filesystem path or storage key
    dicomUrl         String?   // public URL to retrieve the DICOM or preview
    dicomReceivedAt  DateTime? // when the file was ingested
    metadata         Json?
    laudos           Report[]
    addendums        ReportAddendum[]
    dicomFiles       DicomFile[]
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    isActive         Boolean  @default(true)

    @@index([branchId])
    @@index([appointmentId])
    @@index([dicomStudyUid])
    @@map("report_worklist_items")
}

model DicomFile {
    id             String               @id @default(uuid())
    worklistItemId String
    worklistItem   ReportWorklistItem   @relation(fields: [worklistItemId], references: [id], onDelete: Cascade)
    studyUid       String?
    seriesUid      String?
    instanceId     String?              @unique
    path           String
    createdAt      DateTime             @default(now())

    @@index([worklistItemId])
    @@map("dicom_files")
}

model OrthancStudy {
    studyUid    String   @id
    processedAt DateTime @default(now())

    @@map("orthanc_studies")
}

model ReportAddendum {
    id               String              @id @default(uuid())
    branchId         String?
    worklistItemId   String?             // legacy: link to worklist item (kept for backward compat)
    reportId         String?             // preferred: link to Report (laudo)
    content          String              @db.Text
    status           String              @default("draft")
    issuerSignedAt   String?
    reviewerSignedAt String?
    savedAt          String?
    finalizedAt      String?
    createdAt        DateTime            @default(now())
    updatedAt        DateTime            @updatedAt
    isActive         Boolean             @default(true)
    worklistItem     ReportWorklistItem? @relation(fields: [worklistItemId], references: [id], onDelete: SetNull)
    report           Report?             @relation(fields: [reportId], references: [id], onDelete: Cascade)

    @@index([branchId])
    @@index([worklistItemId, status])
    @@index([reportId, status])
    @@map("report_addendums")
}

model ReportTemplate {
    id        String   @id @default(uuid())
    branchId  String?
    name      String
    examType  String
    group     String?
    content   String   @db.Text
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isActive  Boolean  @default(true)

    @@index([branchId])
    @@map("report_templates")
}

model ReportPhrase {
    id        String   @id @default(uuid())
    branchId  String?
    examType  String
    label     String
    text      String   @db.Text
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isActive  Boolean  @default(true)

    @@index([branchId])
    @@map("report_phrases")
}

model ReportConfig {
    id               String   @id @default(uuid())
    branchId         String?
    requiresReviewer Boolean  @default(true)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@index([branchId])
    @@map("report_configs")
}

model Envelopment {
    id           String   @id @default(uuid())
    branchId     String?
    patientName  String?
    dateTime     String?
    responsible  String?
    status       String?
    pages        Int?
    documentType String?
    description  String?
    fileName     String?
    fileUrl      String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    isActive     Boolean  @default(true)

    @@index([branchId])
    @@map("envelopments")
}

model Document {
    id           String   @id @default(uuid())
    branchId     String?
    patientName  String?
    documentType String?
    description  String?
    status       String?
    fileName     String?
    fileUrl      String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    isActive     Boolean  @default(true)

    @@index([branchId])
    @@map("documents")
}

model Procedure {
    id                 String            @id @default(uuid())
    branchId           String?
    name               String
    description        String?
    price              Decimal?          @db.Decimal(10, 2)
    durationMinutes    Int?
    acceptsInsurance   Boolean           @default(false)
    acceptedInsurances String[]          @default([])
    modalities         String[]          @default([])
    isActive           Boolean           @default(true)
    createdAt          DateTime          @default(now())
    updatedAt          DateTime          @updatedAt
    doctors            ProcedureDoctor[]
    evolutionTemplates TeaEvolutionTemplate[]
    materials          ProcedureMaterial[]
    equipmentLinks     MedicalEquipmentProcedure[]

    @@index([branchId])
    @@map("procedures")
}

model MedicalEquipment {
    id               String   @id @default(uuid())
    branchId         String?
    roomId           String?
    room             Sector?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
    name             String
    manufacturer     String?
    model            String?
    modality         String?
    integrationType  String   @default("MWL_BRIDGE")
    bridgeIdentifier String?
    aeTitle          String?
    mwlRemoteAeTitle String?
    storeRemoteAeTitle String?
    stationName      String?
    serialNumber     String?
    patrimonyCode    String?
    mwlHost          String?
    mwlPort          Int?
    storeHost        String?
    storePort        Int?
    dicomWebPath     String?
    supportsWorklist Boolean  @default(false)
    supportsStore    Boolean  @default(true)
    supportsPrint    Boolean  @default(false)
    status           String   @default("Ativo")
    observations     String?  @db.Text
    lastTestStatus   String?
    lastTestMessage  String?  @db.Text
    lastTestedAt     DateTime?
    isActive         Boolean  @default(true)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    procedures MedicalEquipmentProcedure[]

    @@index([branchId])
    @@index([roomId])
    @@map("medical_equipments")
}

model MedicalEquipmentProcedure {
    id                 String           @id @default(uuid())
    medicalEquipmentId String
    procedureId        String
    createdAt          DateTime         @default(now())

    medicalEquipment MedicalEquipment @relation(fields: [medicalEquipmentId], references: [id], onDelete: Cascade)
    procedure        Procedure        @relation(fields: [procedureId], references: [id], onDelete: Cascade)

    @@unique([medicalEquipmentId, procedureId])
    @@index([medicalEquipmentId])
    @@index([procedureId])
    @@map("medical_equipment_procedures")
}

model ProcedureMaterial {
    id              String        @id @default(uuid())
    procedureId     String
    inventoryItemId String
    quantity        Int           @default(1)
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt

    procedure     Procedure     @relation(fields: [procedureId], references: [id], onDelete: Cascade)
    inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

    @@unique([procedureId, inventoryItemId])
    @@index([procedureId])
    @@index([inventoryItemId])
    @@map("procedure_materials")
}

model TeaEvolutionTemplate {
    id                  String   @id @default(uuid())
    branchId            String
    procedureId         String
    procedure           Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
    name                String?
    sessionGoal         String?  @db.Text
    interventionSummary String?  @db.Text
    patientResponse     String?  @db.Text
    familyFeedback      String?  @db.Text
    homePlan            String?  @db.Text
    strategiesUsed      String[] @default([])
    isActive            Boolean  @default(true)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@unique([branchId, procedureId])
    @@index([branchId])
    @@index([procedureId])
    @@map("tea_evolution_templates")
}

model ProcedureDoctor {
    id          String   @id @default(uuid())
    procedureId String
    doctorId    String
    doctorName  String?
    createdAt   DateTime @default(now())

    procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

    @@unique([procedureId, doctorId])
    @@map("procedure_doctors")
}

model Insurance {
    id          String   @id @default(uuid())
    branchId    String?
    name        String
    code        String?
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    subInsurances SubInsurance[]

    @@index([branchId])
    @@map("insurances")
}

model SubInsurance {
    id          String   @id @default(uuid())
    branchId    String?
    insuranceId String
    insurance   Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
    name        String
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([insuranceId, name])
    @@index([branchId])
    @@index([insuranceId])
    @@map("sub_insurances")
}

model FacialLog {
    id        String   @id @default(uuid())
    patientId String
    patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    userId    String
    trust     Decimal  @db.Decimal(5, 4)
    createdAt DateTime @default(now())

    @@index([patientId])
    @@index([userId])
    @@index([createdAt])
    @@map("facial_logs")
}

model WhatsAppConfig {
    id          String   @id @default(uuid())
    branchId    String   @unique
    accountSid  String
    authToken   String
    fromNumber  String
    appId       String?  // Gupshup App ID (UUID) — usado para sincronizar status de templates HSM
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([branchId])
    @@map("whatsapp_configs")
}

enum WhatsAppMessageType {
    APPOINTMENT_CREATED
    APPOINTMENT_CONFIRMATION
    APPOINTMENT_REMINDER
    APPOINTMENT_CANCELED
}

model WhatsAppMessageTemplate {
    id                String              @id @default(uuid())
    branchId          String
    type              WhatsAppMessageType
    name              String
    message           String              @db.Text
    hsmTemplateName   String?             // Nome do template HSM no Gupshup (ex: "confirmacao_agendamento")
    hsmTemplateApproved Boolean           @default(false) // true = aprovado pela Meta
    isActive          Boolean             @default(true)
    createdAt         DateTime            @default(now())
    updatedAt         DateTime            @updatedAt

    @@unique([branchId, type])
    @@index([branchId])
    @@map("whatsapp_message_templates")
}

model WhatsAppNotificationConfig {
    id                            String   @id @default(uuid())
    branchId                      String   @unique
    sendOnAppointmentCreated      Boolean  @default(true)
    sendConfirmationEnabled       Boolean  @default(true)
    confirmationHoursBefore       Int      @default(24)
    sendReminderEnabled           Boolean  @default(false)
    reminderHoursBefore           Int      @default(2)
    createdAt                     DateTime @default(now())
    updatedAt                     DateTime @updatedAt

    @@index([branchId])
    @@map("whatsapp_notification_configs")
}

model WhatsAppMessageLog {
    id                 String   @id @default(uuid())
    branchId           String
    appointmentId      String?
    patientName        String?
    patientPhone       String
    messageType        WhatsAppMessageType
    message            String   @db.Text
    status             String   @default("PENDING")
    errorMessage       String?  @db.Text
    providerMessageId  String?
    sentAt             DateTime?
    deliveredAt        DateTime?
    readAt             DateTime?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@index([branchId])
    @@index([appointmentId])
    @@index([status])
    @@index([createdAt])
    @@map("whatsapp_message_logs")
}
