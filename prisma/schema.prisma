    answers ConsultationNursingAnswer[]

    @@index([consultationId])
    @@map("consultation_nursing_responses")
}

model ConsultationNursingAnswer {
    id            String   @id @default(uuid())
    responseId     String
    response       ConsultationNursingResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
    questionId     String?
    questionLabel  String
    responseType   String
    answerText     String? @db.Text
    answerValues   String[] @default([])
    answerBoolean  Boolean?
    answerNumber   Float?
    orderIndex     Int      @default(0)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    @@index([responseId])
    @@map("consultation_nursing_answers")
}

model ProcedureDoctor {
    id          String   @id @default(uuid())
    procedureId String
    doctorId    String
    doctorName  String?
    createdAt   DateTime @default(now())

    procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

    @@unique([procedureId, doctorId])
    @@map("procedure_doctors")
}

model Insurance {
    id          String   @id @default(uuid())
    branchId    String?
    name        String
    code        String?
    description String?
    tissRegistroAns String?
    tissOperadoraCnpj String?
    tissVersao String?
    tissPrestadorCnpj String?
    tissPrestadorCnes String?
    tissCodigoPrestadorOperadora String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    subInsurances SubInsurance[]

    @@index([branchId])
    @@map("insurances")
}

model SubInsurance {
    id          String   @id @default(uuid())
    branchId    String?
    insuranceId String
    insurance   Insurance @relation(fields: [insuranceId], references: [id], onDelete: Cascade)
    name        String
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([insuranceId, name])
    @@index([branchId])
    @@index([insuranceId])
    @@map("sub_insurances")
}

model FacialLog {
    id        String   @id @default(uuid())
    patientId String
    patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    userId    String
    trust     Decimal  @db.Decimal(5, 4)
    createdAt DateTime @default(now())

    @@index([patientId])
    @@index([userId])
    @@index([createdAt])
    @@map("facial_logs")
}

model WhatsAppConfig {
    id          String   @id @default(uuid())
    branchId    String   @unique
    accountSid  String
    authToken   String
    fromNumber  String
    appId       String?  // Gupshup App ID (UUID) — usado para sincronizar status de templates HSM
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([branchId])
    @@map("whatsapp_configs")
}

enum WhatsAppMessageType {
    APPOINTMENT_CREATED
    TELECONSULTATION_LINK
    APPOINTMENT_CONFIRMATION
    APPOINTMENT_REMINDER
    EXAM_REPORT_READY
    APPOINTMENT_CANCELED
    NO_SHOW
    CONFIRMATION_REPLY_CONFIRMED
    CONFIRMATION_REPLY_RESCHEDULE
}

enum WhatsAppConversationState {
    MENU
    AWAITING_SERVICE
    AWAITING_UNIT
    AWAITING_INSURANCE
    AWAITING_PROCEDURE
    AWAITING_PROCEDURE_NOT_FOUND_ACTION
    AWAITING_PRIVATE_PROCEDURE_INPUT
    AWAITING_PRIVATE_PROCEDURE_CONFIRMATION
    AWAITING_PRIVATE_PROCEDURE_MATCH_CONFIRMATION
    AWAITING_SLOT_CONFIRMATION
    AWAITING_PREFERRED_DATE
    AWAITING_CPF
    AWAITING_CPF_CONFIRMATION
    AWAITING_NEW_PATIENT_NAME
    AWAITING_NEW_PATIENT_BIRTHDATE
    AWAITING_NEW_PATIENT_GENDER
    AWAITING_FINAL_CONFIRMATION
    AWAITING_CONFIRMATION_EDIT_SELECTION
    COMPLETED
    HANDED_OFF
}

model WhatsAppMessageTemplate {
    id                  String              @id @default(uuid())
    branchId            String
    type                WhatsAppMessageType
    name                String
    message             String              @db.Text
    hsmTemplateName     String?             // Nome do template HSM no Gupshup (ex: "confirmacao_agendamento")
    hsmTemplateId       String?             // ID interno do template retornado pelo Gupshup
    hsmTemplateStatus   String?             // Status raw: APPROVED, REJECTED, PENDING, etc.
    hsmTemplateApproved Boolean             @default(false) // true = aprovado pela Meta
    importedFromGupshupSync Boolean         @default(false)
    isActive            Boolean             @default(true)
    createdAt           DateTime            @default(now())
    updatedAt           DateTime            @updatedAt

    @@unique([branchId, type])
    @@index([branchId])
    @@map("whatsapp_message_templates")
}

model WhatsAppNotificationConfig {
    id                            String   @id @default(uuid())
    branchId                      String   @unique
    sendOnAppointmentCreated      Boolean  @default(true)
    sendConfirmationEnabled       Boolean  @default(true)
    confirmationHoursBefore       Int      @default(24)
    sendReminderEnabled           Boolean  @default(false)
    reminderHoursBefore           Int      @default(2)
    createdAt                     DateTime @default(now())
    updatedAt                     DateTime @updatedAt

    @@index([branchId])
    @@map("whatsapp_notification_configs")
}

model WhatsAppMessageLog {
    id                 String   @id @default(uuid())
    branchId           String
    appointmentId      String?
    patientName        String?
    patientPhone       String
    messageType        WhatsAppMessageType
    message            String   @db.Text
    status             String   @default("PENDING")
    errorMessage       String?  @db.Text
    providerMessageId  String?
    sentAt             DateTime?
    deliveredAt        DateTime?
    readAt             DateTime?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@index([branchId])
    @@index([appointmentId])
    @@index([status])
    @@index([createdAt])
    @@map("whatsapp_message_logs")
}

model WhatsAppConversation {
    id                    String                    @id @default(uuid())
    branchId              String
    phone                 String
    patientId             String?
    patientName           String?
    state                 WhatsAppConversationState @default(MENU)
    selectedService       String?
    context               Json?
    lastInboundMessage    String?
    lastOutboundMessage   String?
    handoffTicketId       String?
    reservedAppointmentId String?
    humanStatus           WhatsAppHumanConversationStatus?
    humanFlowKey          String?
    humanFlowLabel        String?
    humanAssignedUserId   String?
    humanAssignedUserName String?
    humanAssignedAt       DateTime?
    humanClosedAt         DateTime?
    humanClosedByUserId   String?
    humanClosedByUserName String?
    humanProtocolNumber   String?
    humanProtocolStartedAt DateTime?
    humanProtocolClosedAt DateTime?
    humanIdleWarningSentAt DateTime?
    humanLastOperatorMessageAt DateTime?
    humanLastPatientMessageAt DateTime?
    lastInteractionAt     DateTime                  @default(now())
    createdAt             DateTime                  @default(now())
    updatedAt             DateTime                  @updatedAt
    messages              WhatsAppConversationMessage[]

    @@unique([branchId, phone])
    @@index([branchId])
    @@index([patientId])
    @@index([state])
    @@index([lastInteractionAt])
    @@index([humanStatus])
    @@index([humanAssignedUserId])
    @@index([humanFlowKey])
    @@map("whatsapp_conversations")
}

enum WhatsAppHumanConversationStatus {
    QUEUED
    ASSIGNED
    CLOSED
}

enum WhatsAppConversationMessageAuthorType {
    PATIENT
    BOT
    OPERATOR
    SYSTEM
}

model WhatsAppConversationMessage {
    id             String                             @id @default(uuid())
    conversationId String
    conversation   WhatsAppConversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    branchId       String
    phone          String
    flowKey        String?
    authorType     WhatsAppConversationMessageAuthorType
    authorUserId   String?
    authorName     String?
    providerMessageId String?
    metadata       Json?
    message        String                             @db.Text
    createdAt      DateTime                           @default(now())

    @@index([conversationId, createdAt])
    @@index([branchId, createdAt])
    @@index([phone, createdAt])
    @@index([providerMessageId])
    @@map("whatsapp_conversation_messages")
}

model WhatsAppConversationOperatorConfig {
    id                     String   @id @default(uuid())
    userId                 String   @unique
    isActive               Boolean  @default(true)
    flowKeys               String[] @default([])
    maxActiveConversations Int      @default(3)
    createdAt              DateTime @default(now())
    updatedAt              DateTime @updatedAt

    @@index([isActive])
    @@map("whatsapp_conversation_operator_configs")
}

model WhatsAppConversationSettings {
    id                  String   @id @default(uuid())
    branchId            String   @unique
    idleTimeoutMinutes  Int      @default(25)
    closeWarningMinutes Int      @default(5)
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@index([branchId])
    @@map("whatsapp_conversation_settings")
}

enum LeadStatus {
    NEW
    CONTACTED
    QUALIFIED
    LOST
}

model Lead {
    id          String     @id @default(uuid())
    name        String
    email       String
    phone       String?
    companyName String?
    message     String?    @db.Text
    source      String?
    status      LeadStatus @default(NEW)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    @@index([status])
    @@index([createdAt])
    @@index([email])
    @@map("leads")
}

enum TicketType {
    BUG
    ERROR
    IMPROVEMENT
}

enum TicketStatus {
    OPEN
    TRIAGE
    IN_PROGRESS
    RESOLVED
    CLOSED
}

enum TicketPriority {
    LOW
    MEDIUM
    HIGH
    CRITICAL
}

model Ticket {
    id              String       @id @default(uuid())
    flow            String
    module          String
    type            TicketType
    description     String       @db.Text
    status          TicketStatus @default(OPEN)
    priority        TicketPriority @default(MEDIUM)
    createdByUserId String?
    createdByName   String?
    createdByEmail  String?
    branchId        String?
    branchName      String?
    lastUserMessageAt DateTime?
    lastAdminMessageAt DateTime?
    lastReadByUserAt DateTime?
    lastReadByAdminAt DateTime?
    resolutionConfirmationDeadlineAt DateTime?
    resolutionConfirmedAt DateTime?
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt
    messages        TicketMessage[]

    @@index([status])
    @@index([priority])
    @@index([createdAt])
    @@index([createdByUserId])
    @@index([branchId])
    @@map("tickets")
}

enum TicketMessageAuthorRole {
    USER
    ADMIN
    SYSTEM
}

model TicketMessage {
    id           String                  @id @default(uuid())
    ticketId     String
    ticket       Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    authorRole   TicketMessageAuthorRole
    authorUserId String?
    authorName   String?
    authorEmail  String?
    message      String                  @db.Text
    attachmentName String?
    attachmentMimeType String?
    attachmentSizeBytes Int?
    attachmentObjectName String?
    createdAt    DateTime                @default(now())

    @@index([ticketId, createdAt])
    @@map("ticket_messages")
}
