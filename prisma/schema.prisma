generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum MaritalStatus {
    SINGLE
    MARRIED
    DIVORCED
    WIDOWED
    OTHER
}

enum BloodType {
    A_POSITIVE
    A_NEGATIVE
    B_POSITIVE
    B_NEGATIVE
    AB_POSITIVE
    AB_NEGATIVE
    O_POSITIVE
    O_NEGATIVE
}

enum TeaPreReservationStatus {
    PENDING_SCHEDULING
    PROPOSED
    RESERVED
    PENDING_AUTHORIZATION
    AUTHORIZED
    CONVERTED
    EXPIRED
    CANCELED
}

model Company {
    id        String   @id @default(uuid())
    cnpj      String   @unique
    legalName String
    tradeName String
    address   String
    phone     String
    branches  Branch[]

    @@map("companies")
}

model Branch {
    id         String          @id @default(uuid())
    companyId  String
    company    Company         @relation(fields: [companyId], references: [id])
    tradeName  String
    address    String
    phone      String
    isMatriz   Boolean         @default(false)
    sectors    Sector[]
    settings   BranchSettings?

    @@map("branches")
}

model BranchSettings {
    id                              String  @id @default(uuid())
    branchId                        String  @unique
    branch                          Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
    requireFacialForReportDelivery  Boolean @default(false)

    @@map("branch_settings")
}

model Sector {
    id          String @id @default(uuid())
    branchId    String
    branch      Branch @relation(fields: [branchId], references: [id])
    name        String
    description String
    users       User[]
    doctors     Doctor[]

    @@map("sectors")
}

model Access {
    id          String   @id @default(uuid())
    description String
    modules     Module[]
    users       User[]

    @@map("accesses")
}

model Module {
    id          String   @id @default(uuid())
    name        String   @unique
    label       String
    description String
    icon        String?
    category    String
    accesses    Access[]

    @@map("modules")
}

model User {
    id                 String              @id @default(uuid())
    sectorId           String
    sector             Sector              @relation(fields: [sectorId], references: [id])
    accesses           Access[]
    name               String
    birthDate          DateTime
    email              String              @unique
    cpf                String?             @unique
    password           String              @default("")
    phone              String
    address            String
    passwordResetCodes PasswordResetCode[]

    @@map("users")
}

model AdminUser {
    id                String    @id @default(uuid())
    name              String
    email             String    @unique
    password          String
    emailCodeHash     String?
    emailCodeExpiresAt DateTime?
    emailVerifiedAt   DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt

    @@map("admin_users")
}

model PasswordResetCode {
    id                String    @id @default(uuid())
    userId            String
    user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    codeHash          String
    requestIdentifier String
    attempts          Int       @default(0)
    expiresAt         DateTime
    usedAt            DateTime?
    createdAt         DateTime  @default(now())

    @@index([userId, createdAt])
    @@map("password_reset_codes")
}

model Doctor {
    id                String   @id @default(uuid())
    branchId          String?
    crm               String
    crmState          String   @db.VarChar(2)
    name              String
    email             String   @unique
    phone             String
    cellphone         String?
    birthDate         DateTime
    gender            Gender
    cpf               String   @unique @db.VarChar(11)
    rg                String?
    specialty         String
    specialties       String[] @default([])
    consultationFee   Decimal? @db.Decimal(10, 2)
    biography         String?  @db.Text
    address           String?
    addressNumber     String?
    addressComplement String?
    neighborhood      String?
    city              String?
    state             String?  @db.VarChar(2)
    zipCode           String?  @db.VarChar(8)
    roomId            String?
    room              Sector?  @relation(fields: [roomId], references: [id], onDelete: SetNull)
    isActive          Boolean  @default(true)
    workingDays       String[] @default([])
    workingHoursStart String?
    workingHoursEnd   String?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    medicalRecords MedicalRecord[]

    @@unique([crm, crmState])
    @@index([branchId])
    @@map("doctors")
}

model Patient {
    id                           String         @id @default(uuid())
    branchId                     String?
    name                         String
    email                        String?
    phone                        String?
    cellphone                    String
    birthDate                    DateTime
    gender                       Gender
    cpf                          String         @unique @db.VarChar(11)
    rg                           String?
    maritalStatus                MaritalStatus?
    occupation                   String?
    address                      String?
    addressNumber                String?
    addressComplement            String?
    neighborhood                 String?
    city                         String?
    state                        String?        @db.VarChar(2)
    zipCode                      String?        @db.VarChar(8)
    emergencyContactName         String?
    emergencyContactPhone        String?
    emergencyContactRelationship String?
    hasGuardian                  Boolean        @default(false)
    guardianName                 String?
    guardianCpf                  String?        @db.VarChar(11)
    guardianPhone                String?
    guardianRelationship         String?
    hasHealthInsurance           Boolean        @default(false)
    healthInsuranceName          String?
    healthInsuranceNumber        String?
    healthInsuranceExpiry        DateTime?
    bloodType                    BloodType?
    allergies                    String[]       @default([])
    chronicConditions            String[]       @default([])
    currentMedications           String[]       @default([])
    observations                 String?        @db.Text
    image                        Bytes?
    isActive                     Boolean        @default(true)
    createdAt                    DateTime       @default(now())
    updatedAt                    DateTime       @updatedAt

    medicalRecords     MedicalRecord[]
    teaProfile         TeaProfile?
    teaPreReservations TeaPreReservation[]
    facialLogs         FacialLog[]

    @@index([branchId])
    @@map("patients")
}

model TeaProfile {
    id                   String   @id @default(uuid())
    patientId            String   @unique
    patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    supportLevel         String?
    communicationProfile String?  @db.Text
    sensoryProfile       String?  @db.Text
    behaviorNotes        String?  @db.Text
    comorbidities        String[] @default([])
    therapeuticGoals     String?  @db.Text
    familyGuidance       String?  @db.Text
    schoolNotes          String?  @db.Text
    isActive             Boolean  @default(true)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    plans           TeaTherapeuticPlan[]
    evolutions      TeaEvolution[]
    pit             TeaPit?
    preReservations TeaPreReservation[]

    @@map("tea_profiles")
}

model TeaTherapeuticPlan {
    id                      String     @id @default(uuid())
    teaProfileId            String
    teaProfile              TeaProfile @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    title                   String
    objective               String?    @db.Text
    priority                String     @default("Média")
    status                  String     @default("Ativo")
    responsibleDoctorId     String?
    responsibleProfessional String?
    targetDate              DateTime?
    notes                   String?    @db.Text
    isActive                Boolean    @default(true)
    createdAt               DateTime   @default(now())
    updatedAt               DateTime   @updatedAt

    evolutions TeaEvolution[]

    @@index([teaProfileId])
    @@map("tea_therapeutic_plans")
}

model TeaEvolution {
    id                   String              @id @default(uuid())
    teaProfileId         String
    teaProfile           TeaProfile          @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    therapeuticPlanId    String?
    therapeuticPlan      TeaTherapeuticPlan? @relation(fields: [therapeuticPlanId], references: [id], onDelete: SetNull)
    sessionDate          DateTime            @default(now())
    professionalDoctorId String?
    professional         String?
    interventionSummary  String?             @db.Text
    patientResponse      String?             @db.Text
    progressScore        Int?
    notes                String?             @db.Text
    createdAt            DateTime            @default(now())
    updatedAt            DateTime            @updatedAt

    @@index([teaProfileId])
    @@index([therapeuticPlanId])
    @@map("tea_evolutions")
}

model TeaPit {
    id           String     @id @default(uuid())
    teaProfileId String     @unique
    teaProfile   TeaProfile @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    title        String
    startDate    DateTime?
    reviewDate   DateTime?
    status       String     @default("Ativo")
    notes        String?    @db.Text
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    therapies       TeaPitTherapy[]
    preReservations TeaPreReservation[]

    @@map("tea_pits")
}

model TeaPitTherapy {
    id                   String   @id @default(uuid())
    pitId                String
    pit                  TeaPit   @relation(fields: [pitId], references: [id], onDelete: Cascade)
    procedureId          String?
    therapyType          String
    weeklyFrequency      Int      @default(1)
    preferredWeekdays    String[] @default([])
    preferredShift       String?
    durationMinutes      Int?
    professionalDoctorId String?
    professional         String?
    notes                String?  @db.Text
    isActive             Boolean  @default(true)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    preReservations TeaPreReservation[]

    @@index([pitId])
    @@map("tea_pit_therapies")
}

model MedicalRecord {
    id                      String   @id @default(uuid())
    patientId               String
    patient                 Patient  @relation(fields: [patientId], references: [id])
    doctorId                String?
    doctor                  Doctor?  @relation(fields: [doctorId], references: [id])
    chiefComplaint          String?  @db.Text
    historyOfPresentIllness String?  @db.Text
    physicalExamination     String?  @db.Text
    diagnosis               String?  @db.Text
    treatment               String?  @db.Text
    prescriptions           String?  @db.Text
    examRequests            String?  @db.Text
    notes                   String?  @db.Text
    bloodPressureSystolic   Int?
    bloodPressureDiastolic  Int?
    heartRate               Int?
    respiratoryRate         Int?
    temperature             Decimal? @db.Decimal(4, 1)
    oxygenSaturation        Int?
    weight                  Decimal? @db.Decimal(5, 2)
    height                  Decimal? @db.Decimal(3, 2)
    bmi                     Decimal? @db.Decimal(4, 1)
    recordDate              DateTime @default(now())
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt

    @@map("medical_records")
}

model AdminEntity {
    id   String @id @default(uuid())
    name String

    @@map("admin_entities")
}

model InventoryItem {
    id          String    @id @default(uuid())
    code        String    @unique
    name        String
    category    String?
    unit        String?
    quantity    Int       @default(0)
    minQuantity Int?
    maxQuantity Int?
    unitPrice   Decimal?  @db.Decimal(12, 2)
    expiryDate  DateTime?
    status      String    @default("AVAILABLE")
    notes       String?   @db.Text
    isActive    Boolean   @default(true)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@map("inventory_items")
}

model FinanceEntry {
    id            String    @id @default(uuid())
    type          String
    category      String?
    description   String?   @db.Text
    value         Decimal   @db.Decimal(12, 2)
    discount      Decimal?  @db.Decimal(12, 2)
    total         Decimal   @db.Decimal(12, 2)
    dueDate       DateTime?
    status        String    @default("PENDING")
    paymentMethod String?
    relatedName   String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    isActive      Boolean   @default(true)

    @@map("finance_entries")
}

model Invoice {
    id            String    @id @default(uuid())
    number        String    @unique
    patientName   String?
    issuedAt      DateTime  @default(now())
    dueDate       DateTime?
    status        String    @default("EMITIDA")
    convention    String?
    value         Decimal   @db.Decimal(12, 2)
    discount      Decimal?  @db.Decimal(12, 2)
    total         Decimal   @db.Decimal(12, 2)
    paymentMethod String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    isActive      Boolean   @default(true)

    @@map("invoices")
}

model Delivery {
    id           String    @id @default(uuid())
    patientName  String
    documentType String
    availableAt  DateTime  @default(now())
    description  String?   @db.Text
    responsible  String?
    status       String    @default("DISPONIVEL")
    deliveredTo  String?
    deliveredAt  DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    isActive     Boolean   @default(true)

    @@map("deliveries")
}

model PreAttendance {
    id                 String   @id @default(uuid())
    branchId           String?
    fullName           String
    cpf                String
    patientId          String?
    birthDate          String?
    gender             String?
    phone              String?
    email              String?
    address            String?
    convenio           String?
    convenioType       String?
    convenioValidUntil String?
    convenioNumber     String?
    convenioStatus     String?
    convenioNotes      String?
    bloodPressure      String?
    heartRate          String?
    temperature        String?
    oxygenSaturation   String?
    weight             String?
    height             String?
    glucose            String?
    bmi                String?
    mainComplaint      String?
    diseaseHistory     String?
    allergies          String?
    medications        String?
    antecedentes       String?
    triageNotes        String?
    notes              String?
    totem              Int?
    status             String?
    queue              String?
    queueType          String?
    agenda             String?
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
    isActive           Boolean  @default(true)

    @@index([branchId])
    @@map("pre_attendances")
}

model TeaPreReservation {
    id                   String                      @id @default(uuid())
    teaProfileId         String
    teaProfile           TeaProfile                  @relation(fields: [teaProfileId], references: [id], onDelete: Cascade)
    pitId                String
    pit                  TeaPit                      @relation(fields: [pitId], references: [id], onDelete: Cascade)
    pitTherapyId         String
    pitTherapy           TeaPitTherapy               @relation(fields: [pitTherapyId], references: [id], onDelete: Cascade)
    patientId            String
    patient              Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
    procedureId          String?
    procedureName        String?
    professionalDoctorId String?
    professionalName     String?
    suggestedDate        DateTime?
    suggestedTime        String?
    durationMinutes      Int?
    status               TeaPreReservationStatus     @default(PENDING_SCHEDULING)
    notes                String?                     @db.Text
    expiresAt            DateTime?
    authorizedAt         DateTime?
    convertedAt          DateTime?
    createdAt            DateTime                    @default(now())
    updatedAt            DateTime                    @updatedAt
    timelineEvents       TeaPreReservationTimeline[]

    @@index([status])
    @@index([pitTherapyId, status])
    @@index([patientId])
    @@map("tea_pre_reservations")
}

model TeaPreReservationTimeline {
    id               String            @id @default(uuid())
    preReservationId String
    preReservation   TeaPreReservation @relation(fields: [preReservationId], references: [id], onDelete: Cascade)
    eventType        String
    eventLabel       String
    actor            String?
    payload          Json?
    createdAt        DateTime          @default(now())

    @@index([preReservationId, createdAt])
    @@map("tea_pre_reservation_timeline")
}

model Appointment {
    id              String   @id @default(uuid())
    branchId        String?
    patientName     String?
    patientCpf      String?
    patientId       String?
    doctorName      String?
    specialty       String?
    convenio        String?
    date            String?
    time            String?
    durationMinutes Int?
    type            String?
    status          String?
    authorizationStatus String @default("PENDING")
    authorizationNotes  String? @db.Text
    authorizedAt        DateTime?
    observations    String?
    totem           Int?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    isActive        Boolean  @default(true)

    @@index([branchId])
    @@index([authorizationStatus], map: "appointments_authorizationStatus_idx")
    @@map("appointments")
}

model Consultation {
    id               String   @id @default(uuid())
    branchId         String?
    patientName      String?
    convenio         String?
    convenioStatus   String?
    scheduledFor     String?
    queueType        String?
    agenda           String?
    totem            String?
    queue            String?
    bloodPressure    String?
    heartRate        String?
    temperature      String?
    oxygenSaturation String?
    weight           String?
    height           String?
    glucose          String?
    bmi              String?
    anamnese         String?
    mainComplaint    String?
    diseaseHistory   String?
    allergies        String?
    medications      String?
    antecedentes     String?
    pregnant         String?
    triageNotes      String?
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    isActive         Boolean  @default(true)

    @@index([branchId])
    @@map("consultations")
}

model Report {
    id                String   @id @default(uuid())
    branchId          String?
    patientName       String
    cpf               String?
    birthDate         String?
    requestingDoctor  String?
    reportingDoctor   String?
    reviewingDoctor   String?
    description       String?
    conclusion        String?
    notes             String?
    status            String?
    exam              String?
    scheduledFor      String?
    responsibleDoctor String?
    observation       String?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
    isActive          Boolean  @default(true)

    @@index([branchId])
    @@map("reports")
}

model ReportWorklistItem {
    id               String   @id @default(uuid())
    branchId         String?
    externalStudyId  String?
    accessionNumber  String?
    patientName      String
    patientCpf       String?
    patientBirthDate String?
    examType         String
    scheduledAt      String?
    convenio         String?
    requestingDoctor String?
    assignedTo       String?
    priority         String   @default("normal")
    status           String   @default("pendente")
    reportText       String?  @db.Text
    issuerSignedAt   String?
    reviewerSignedAt String?
    dicomStudyUid    String?
    dicomSeriesUid   String?
    dicomPath        String?   // local filesystem path or storage key
    dicomUrl         String?   // public URL to retrieve the DICOM or preview
    dicomReceivedAt  DateTime? // when the file was ingested
    metadata         Json?
    addendums        ReportAddendum[]
    dicomFiles       DicomFile[]
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    isActive         Boolean  @default(true)

    @@index([branchId])
    @@index([dicomStudyUid])
    @@map("report_worklist_items")
}

model DicomFile {
    id             String               @id @default(uuid())
    worklistItemId String
    worklistItem   ReportWorklistItem   @relation(fields: [worklistItemId], references: [id], onDelete: Cascade)
    studyUid       String?
    seriesUid      String?
    instanceId     String?              @unique
    path           String
    createdAt      DateTime             @default(now())

    @@index([worklistItemId])
    @@map("dicom_files")
}

model OrthancStudy {
    studyUid    String   @id
    processedAt DateTime @default(now())

    @@map("orthanc_studies")
}

model ReportAddendum {
    id               String             @id @default(uuid())
    branchId         String?
    worklistItemId   String
    content          String             @db.Text
    status           String             @default("draft")
    issuerSignedAt   String?
    reviewerSignedAt String?
    savedAt          String?
    finalizedAt      String?
    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt
    isActive         Boolean            @default(true)
    worklistItem     ReportWorklistItem @relation(fields: [worklistItemId], references: [id], onDelete: Cascade)

    @@index([branchId])
    @@index([worklistItemId, status])
    @@map("report_addendums")
}

model ReportTemplate {
    id        String   @id @default(uuid())
    branchId  String?
    name      String
    examType  String
    group     String?
    content   String   @db.Text
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isActive  Boolean  @default(true)

    @@index([branchId])
    @@map("report_templates")
}

model ReportPhrase {
    id        String   @id @default(uuid())
    branchId  String?
    examType  String
    label     String
    text      String   @db.Text
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isActive  Boolean  @default(true)

    @@index([branchId])
    @@map("report_phrases")
}

model ReportConfig {
    id               String   @id @default(uuid())
    branchId         String?
    requiresReviewer Boolean  @default(true)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    @@index([branchId])
    @@map("report_configs")
}

model Envelopment {
    id           String   @id @default(uuid())
    branchId     String?
    patientName  String?
    dateTime     String?
    responsible  String?
    status       String?
    pages        Int?
    documentType String?
    description  String?
    fileName     String?
    fileUrl      String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    isActive     Boolean  @default(true)

    @@index([branchId])
    @@map("envelopments")
}

model Document {
    id           String   @id @default(uuid())
    branchId     String?
    patientName  String?
    documentType String?
    description  String?
    status       String?
    fileName     String?
    fileUrl      String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    isActive     Boolean  @default(true)

    @@index([branchId])
    @@map("documents")
}

model Procedure {
    id                 String            @id @default(uuid())
    branchId           String?
    name               String
    description        String?
    price              Decimal?          @db.Decimal(10, 2)
    durationMinutes    Int?
    acceptsInsurance   Boolean           @default(false)
    acceptedInsurances String[]          @default([])
    modalities         String[]          @default([])
    isActive           Boolean           @default(true)
    createdAt          DateTime          @default(now())
    updatedAt          DateTime          @updatedAt
    doctors            ProcedureDoctor[]

    @@index([branchId])
    @@map("procedures")
}

model ProcedureDoctor {
    id          String   @id @default(uuid())
    procedureId String
    doctorId    String
    doctorName  String?
    createdAt   DateTime @default(now())

    procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

    @@unique([procedureId, doctorId])
    @@map("procedure_doctors")
}

model Insurance {
    id          String   @id @default(uuid())
    branchId    String?
    name        String
    code        String?
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([branchId])
    @@map("insurances")
}

model FacialLog {
    id        String   @id @default(uuid())
    patientId String
    patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
    userId    String
    trust     Decimal  @db.Decimal(5, 4)
    createdAt DateTime @default(now())

    @@index([patientId])
    @@index([userId])
    @@index([createdAt])
    @@map("facial_logs")
}
