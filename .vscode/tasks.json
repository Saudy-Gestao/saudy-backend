			"label": "print-tea-pre-uncovered-from-coverage-json",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const fs=require('fs');const p='coverage/coverage-final.json';const j=JSON.parse(fs.readFileSync(p,'utf8'));const key=Object.keys(j).find(k=>k.endsWith('/src/modules/care/routes/tea-pre-reservations.ts'));if(!key){console.log('file not found');process.exit(0);}const f=j[key];const uncoveredLines=Object.entries(f.s).filter(([,v])=>v===0).map(([sid])=>f.statementMap[sid].start.line);const uniq=[...new Set(uncoveredLines)].sort((a,b)=>a-b);console.log('UNCOVERED_STATEMENT_LINES',uniq.join(','));const uncoveredBranches=[];for(const [bid,hits] of Object.entries(f.b)){hits.forEach((h,idx)=>{if(h===0){const loc=f.branchMap[bid].locations[idx];uncoveredBranches.push(loc.start.line);}})}const buniq=[...new Set(uncoveredBranches)].sort((a,b)=>a-b);console.log('UNCOVERED_BRANCH_LINES',buniq.join(','));"
			],
			"isBackground": false
		},
